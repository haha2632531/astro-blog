---
import { getCollection } from "astro:content";
import getSortedPosts from "@utils/getSortedPosts";

const posts = await getCollection("blog");
const recent = getSortedPosts(posts).slice(0, 5);
---

<ul class="widget-recent" role="list">
  {
    recent.map(({ data, slug }) => (
      <li>
        <a href={`/posts/${slug}/`}>{data.title}</a>
      </li>
    ))
  }
</ul>

<style>
  .widget-recent {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .widget-recent a {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.18s;
  }
  .widget-recent a:hover {
    color: var(--accent);
  }
</style>
