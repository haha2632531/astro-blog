---
import { SITE } from "@config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`site-footer ${noMarginTop ? "" : "mt-auto"}`}>
  <div class="footer-inner">
    <a
      class="footer-rss"
      href="/rss.xml"
      aria-label="订阅 RSS"
      title="订阅 RSS"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M5 19a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"></path>
        <path d="M4 4a16 16 0 0 1 16 16"></path>
        <path d="M4 11a9 9 0 0 1 9 9"></path>
      </svg>
    </a>
    <p class="footer-line">&#169; {currentYear} &#183; {SITE.title}</p>
    <p class="footer-sub">由 Astro 构建 &#183; 基于 AstroPaper 主题</p>
  </div>
</footer>

<style>
  /* 沿用上一轮的通栏自适应结构：背景与顶部分隔线铺满视口，
     内容层限宽居中、左右留白随屏宽变化。仅把内容改成截图的居中两行。 */
  footer.site-footer {
    display: block;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding: 0;
  }
  .footer-inner {
    box-sizing: border-box;
    width: 100%;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 4vw, 2rem);
    text-align: center;
  }

  .footer-rss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }
  .footer-rss:hover {
    color: var(--accent);
  }
  .footer-rss svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .footer-line,
  .footer-sub {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.8125rem);
    line-height: 1.6;
    font-variant-numeric: tabular-nums;
  }
  .footer-sub {
    margin-top: 0.25rem;
    opacity: 0.75;
    font-size: 0.75rem;
  }

  @media (max-width: 359px) {
    .footer-inner {
      padding-inline: 0.75rem;
    }
  }
</style>
