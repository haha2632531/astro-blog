---
export interface Props {
  noPadding?: boolean;
  ariaHidden?: boolean;
}

const { noPadding = false, ariaHidden = true } = Astro.props;
---

<div
  class={`mx-auto ${noPadding ? "px-0" : "px-4"}`}
  style="max-width: var(--page-width)"
>
  <hr class="border-skin-line" aria-hidden={ariaHidden} />
</div>
