---
export interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="widget-card" aria-labelledby={id}>
  <h2 class="widget-title" id={id}>
    <span class="widget-bar" aria-hidden="true"></span>{title}
  </h2>
  <div class="widget-body">
    <slot />
  </div>
</section>

<style>
  .widget-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.2rem 1.35rem 1.4rem;
    box-shadow: var(--shadow);
  }
  .widget-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font: 600 1.05rem/1.3 var(--display-font);
    letter-spacing: -0.01em;
  }
  .widget-bar {
    width: 0.28rem;
    height: 1.05rem;
    border-radius: 999px;
    background: var(--accent);
  }
  .widget-body {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }
</style>
