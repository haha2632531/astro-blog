---
// 当前路径去掉末尾斜杠后拆成片段，链接仍使用原始 slug
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
const breadcrumbList = currentUrlPath.split("/").slice(1);

// 路径片段 → 中文显示名
const pathLabels: Record<string, string> = {
  posts: "文章",
  tags: "标签",
  about: "关于我",
  search: "搜索",
  services: "技术服务",
  resources: "免费资源",
};
const labelOf = (segment: string) =>
  pathLabels[segment] ?? decodeURIComponent(segment);

// /posts/2/ → 「文章（第 2 页）」
breadcrumbList[0] === "posts" &&
  breadcrumbList.splice(0, 2, `文章（第 ${breadcrumbList[1] || 1} 页）`);

// /tags/[tag]/[page] → 「[tag]（第 N 页）」
breadcrumbList[0] === "tags" &&
  !isNaN(Number(breadcrumbList[2])) &&
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${
      Number(breadcrumbList[2]) === 1
        ? ""
        : "（第 " + breadcrumbList[2] + " 页）"
    }`
  );
---

<nav class="breadcrumb" aria-label="面包屑导航">
  <ul>
    <li>
      <a href="/">首页</a>
      <span aria-hidden="true">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class={`${index > 0 ? "lowercase" : "capitalize"}`}
              aria-current="page"
            >
              {labelOf(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a href={`/${breadcrumb}/`}>{labelOf(breadcrumb)}</a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>

<style>
  .breadcrumb {
    @apply mx-auto mb-1 mt-8 w-full max-w-3xl px-4;
  }
  .breadcrumb ul li {
    @apply inline;
  }
  .breadcrumb ul li a {
    @apply capitalize opacity-70;
  }
  .breadcrumb ul li span {
    @apply opacity-70;
  }
  .breadcrumb ul li:not(:last-child) a {
    @apply hover:opacity-100;
  }
</style>
