---
import { getCollection } from "astro:content";
import getTagsWithCount from "@utils/getTagsWithCount";

const posts = await getCollection("blog");
const tags = getTagsWithCount(posts).slice(0, 20);
---

<ul class="widget-tags" role="list">
  {
    tags.map(({ tag, tagName, count }) => (
      <li>
        <a href={`/tags/${tag}/`}>
          {tagName} <span class="count">({count})</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .widget-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .widget-tags a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      color 0.18s,
      border-color 0.18s,
      background 0.18s;
  }
  .widget-tags a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .widget-tags .count {
    color: var(--muted);
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
</style>
