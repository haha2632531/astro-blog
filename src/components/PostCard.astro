---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime";
import { slugifyStr } from "@utils/slugify";
import { tagLabel } from "@utils/tagLabel";

export interface Props {
  href: string;
  frontmatter: CollectionEntry<"blog">["data"];
  secHeading?: boolean;
}
const { href, frontmatter, secHeading = true } = Astro.props;
const { title, pubDatetime, modDatetime, description, tags, ogImage } =
  frontmatter;

const cover =
  typeof ogImage === "string" ? ogImage : ogImage?.src ?? "/astropaper-og.jpg";
const primaryTag = tags.length ? tags[0] : "未分类";
const primaryTagSlug = slugifyStr(primaryTag);

// 列表页用 h2，首页（section 已有 h2）用 h3，保持标题层级语义
const TitleTag = secHeading ? "h2" : "h3";
---

<li class="post-card">
  <article class="post-card-inner">
    <a class="post-thumb" href={href} aria-label={title}>
      <img
        src={cover}
        alt={`${title} 封面`}
        loading="lazy"
        width="200"
        height="200"
      />
    </a>
    <div class="post-body">
      <div class="post-meta-top">
        <a class="post-cat" href={`/tags/${primaryTagSlug}/`}>
          {tagLabel(primaryTag)}
        </a>
        <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} />
      </div>
      <TitleTag class="post-card__title"><a href={href}>{title}</a></TitleTag>
      <p class="post-excerpt">{description}</p>
    </div>
  </article>
</li>

<style>
  /* 单栏阅读流条目：去掉卡片边框、圆角、阴影与位移，
     分隔线由 editorial.css 的 .card-list > li 统一提供。颜色全部沿用现有变量。 */
  .post-card {
    list-style: none;
    padding: 1.5rem 0;
  }
  .post-card-inner {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .post-thumb {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--surface);
  }
  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.375rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .post-meta-top :global(span) {
    font-size: 0.8125rem;
  }
  .post-meta-top :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .post-cat {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .post-cat:hover {
    text-decoration: underline;
  }

  /* 标题规格取自 aijun.org (ComBox)：阿里普惠体 2rem / 600 / 1.4 / -0.01em。
     中文长标题保留两行截断，不照抄原站桌面端的单行省略。 */
  .post-card__title {
    margin: 0 0 0.5rem;
    font-family: "Ali PuHuiTi", var(--display-font), sans-serif;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .post-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .post-card:hover .post-card__title {
    color: var(--accent);
  }

  .post-excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .post-card-inner {
      grid-template-columns: 4.5rem 1fr;
      gap: 0.9rem;
    }
    .post-card__title {
      font-size: 1.625rem;
    }
  }
</style>
