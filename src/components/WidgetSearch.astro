---
// 复用 Header 里的 GET /search/?q= 链路，零额外 JS
---

<form class="widget-search" action="/search/" method="get" role="search">
  <label class="sr-only" for="widget-search-input">搜索文章</label>
  <input
    id="widget-search-input"
    type="search"
    name="q"
    placeholder="搜索文章..."
    autocomplete="off"
  />
  <button type="submit" aria-label="搜索">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle
        cx="10.8"
        cy="10.8"
        r="6.8"
        fill="none"
        stroke="currentColor"
        stroke-width="2"></circle>
      <path
        d="m16 16 5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
  </button>
</form>

<style>
  .widget-search {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--surface);
    padding: 0.2rem 0.2rem 0.2rem 0.8rem;
  }
  .widget-search input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--ink);
    font-size: 0.9rem;
    padding: 0.5rem 0;
  }
  .widget-search input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }
  .widget-search button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: var(--accent);
    background: transparent;
    transition: background 0.18s;
  }
  .widget-search button:hover {
    background: var(--accent-soft);
  }
  .widget-search svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }
</style>
