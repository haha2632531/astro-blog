---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ContentSingle from "@layouts/ContentSingle.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import PostCard from "@components/PostCard.astro";
import getPostStats from "@utils/postStats";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout title={`文章 | ${SITE.title}`}>
  <Header activeNav="posts" />
  <ContentSingle pageTitle="文章" pageDesc="全部已发布的文章，按更新时间排列。">
    <ul class="card-list">
      {
        paginatedPosts.map(({ data, slug, body }) => {
          const { count, minutes } = getPostStats(body);
          return (
            <PostCard
              href={`/posts/${slug}/`}
              frontmatter={data}
              wordCount={count}
              readingMinutes={minutes}
            />
          );
        })
      }
    </ul>

    <Pagination
      {currentPage}
      {totalPages}
      basePath="/posts"
      prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
      nextUrl={`/posts/${currentPage + 1}/`}
    />
  </ContentSingle>

  <Footer />
</Layout>
