---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ContentSingle from "@layouts/ContentSingle.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostCard from "@components/PostCard.astro";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";
import { tagLabel } from "@utils/tagLabel";
import getPostStats from "@utils/postStats";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName } = Astro.props;
const displayTag = tagLabel(tagName);
---

<Layout title={`标签：${displayTag} | ${SITE.title}`}>
  <Header activeNav="tags" />
  <ContentSingle
    pageTitle={[`标签：`, `${displayTag}`]}
    titleTransition={tag}
    pageDesc={`所有带有「${displayTag}」标签的文章。`}
  >
    <ul class="card-list">
      {
        paginatedPosts.map(({ data, slug, body }) => {
          const { count, minutes } = getPostStats(body);
          return (
            <PostCard
              href={`/posts/${slug}/`}
              frontmatter={data}
              wordCount={count}
              readingMinutes={minutes}
            />
          );
        })
      }
    </ul>

    <Pagination
      {currentPage}
      {totalPages}
      basePath={`/tags/${tag}`}
      prevUrl={`/tags/${tag}${
        currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
      }/`}
      nextUrl={`/tags/${tag}/${currentPage + 1}/`}
    />
  </ContentSingle>

  <Footer />
</Layout>
