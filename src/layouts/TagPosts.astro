---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ContentWithSidebar from "@layouts/ContentWithSidebar.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostCard from "@components/PostCard.astro";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";
import { tagLabel } from "@utils/tagLabel";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName } = Astro.props;
const displayTag = tagLabel(tagName);
---

<Layout title={`标签：${displayTag} | ${SITE.title}`}>
  <Header activeNav="tags" />
  <ContentWithSidebar
    pageTitle={[`标签：`, `${displayTag}`]}
    titleTransition={tag}
    pageDesc={`所有带有「${displayTag}」标签的文章。`}
  >
    <ul class="card-list">
      {
        paginatedPosts.map(({ data, slug }) => (
          <PostCard href={`/posts/${slug}/`} frontmatter={data} />
        ))
      }
    </ul>

    <Pagination
      {currentPage}
      {totalPages}
      prevUrl={`/tags/${tag}${
        currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
      }/`}
      nextUrl={`/tags/${tag}/${currentPage + 1}/`}
    />
  </ContentWithSidebar>

  <Footer noMarginTop={totalPages > 1} />
</Layout>
