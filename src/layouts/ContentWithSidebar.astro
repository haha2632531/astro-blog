---
import Sidebar from "@components/Sidebar.astro";

interface Props {
  pageTitle: string | [string, string];
  titleTransition?: string;
  pageDesc?: string;
}
const { pageTitle, titleTransition, pageDesc } = Astro.props;
---

<main id="main-content" class="content-with-sidebar">
  <div class="content-main">
    <header class="content-head">
      {
        Array.isArray(pageTitle) ? (
          <h1>
            {pageTitle[0]}
            <span transition:name={titleTransition}>{pageTitle[1]}</span>
          </h1>
        ) : (
          <h1>{pageTitle}</h1>
        )
      }
      {pageDesc && <p>{pageDesc}</p>}
    </header>
    <slot />
  </div>
  <Sidebar />
</main>

<style>
  .content-with-sidebar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    max-width: 62rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
  }
  .content-main {
    min-width: 0;
  }
  .content-head {
    margin-bottom: 1.5rem;
  }
  .content-head h1 {
    margin: 0;
    color: var(--ink);
    font: 600 clamp(1.7rem, 3vw, 2.25rem) / 1.2 var(--display-font);
    letter-spacing: -0.035em;
  }
  .content-head p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-style: italic;
  }

  /* .sidebar 自身的 sticky / 间距 / 响应式由 Sidebar.astro 管理，
     避免 scoped 样式跨组件不生效 */

  @media (max-width: 1024px) {
    .content-with-sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>
