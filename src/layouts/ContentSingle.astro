---
interface Props {
  pageTitle: string | [string, string];
  titleTransition?: string;
  pageDesc?: string;
}
const { pageTitle, titleTransition, pageDesc } = Astro.props;
---

<main id="main-content" class="content-single">
  <header class="content-head">
    {
      Array.isArray(pageTitle) ? (
        <h1>
          {pageTitle[0]}
          <span transition:name={titleTransition}>{pageTitle[1]}</span>
        </h1>
      ) : (
        <h1>{pageTitle}</h1>
      )
    }
    {pageDesc && <p>{pageDesc}</p>}
  </header>
  <slot />
</main>

<style>
  /* 单栏阅读流：宽度沿用原有 62rem 容器，配色不变 */
  .content-single {
    max-width: 62rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
  }
  .content-head {
    margin-bottom: 1.5rem;
  }
  .content-head h1 {
    margin: 0;
    color: var(--ink);
    font: 600 clamp(1.7rem, 3vw, 2.25rem) / 1.2 var(--display-font);
    letter-spacing: -0.035em;
  }
  .content-head p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-style: italic;
  }
</style>
