---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <div class="hero-meta">
        <span class="eyebrow">Personal Notes / Journal</span>
        <a
          target="_blank"
          href="/rss.xml"
          class="rss-link"
          aria-label="订阅 RSS"
          title="RSS 订阅"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
            ><path
              d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
            ></path><path
              d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
            ></path><circle cx="6" cy="18" r="2"></circle>
          </svg>
        </a>
      </div>

      <h1>你好，欢迎来到我的博客</h1>

      <p class="lead">
        这里记录我的思考、生活与创作。欢迎阅读文章，也欢迎通过社交平台与我联系。
      </p>

      <p class="sub-copy">
        想了解更多？欢迎浏览博客文章，或查看
        <LinkButton
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href="https://github.com/satnaing/astro-paper#readme"
        >
          项目说明
        </LinkButton>。
      </p>

      {
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">社交平台：</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <h2>精选文章</h2>
            <ul>
              {featuredPosts.map(({ data, slug }) => (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>最新文章</h2>
          <ul>
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < 4 && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        查看全部文章
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  #hero {
    @apply pb-8 pt-10;
  }

  .hero-meta {
    @apply mb-4 flex items-center justify-between gap-3;
  }

  .eyebrow {
    @apply inline-flex items-center rounded-full border border-skin-line/80 px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.24em] text-skin-base/70;
  }

  #hero h1 {
    @apply my-4 text-4xl font-semibold leading-none tracking-[-0.06em] text-skin-base sm:text-6xl;
  }

  #hero .rss-link {
    @apply inline-flex items-center justify-center rounded-full border border-skin-line bg-skin-card/50 p-2 text-skin-base transition-all duration-200 hover:border-skin-accent/70 hover:text-skin-accent;
  }

  #hero .rss-icon {
    @apply h-4 w-4 fill-current;
  }

  .lead {
    @apply mt-5 max-w-2xl text-base leading-7 text-skin-base/80 sm:text-lg;
  }

  .sub-copy {
    @apply mt-3 text-sm leading-7 text-skin-base/70;
  }

  .social-wrapper {
    @apply mt-5 flex flex-col gap-3 sm:flex-row sm:items-center;
  }

  .social-links {
    @apply whitespace-nowrap text-sm text-skin-base/70;
  }

  #featured,
  #recent-posts {
    @apply pb-6 pt-10;
  }

  #featured h2,
  #recent-posts h2 {
    @apply mb-5 text-xl font-semibold tracking-[-0.04em] text-skin-base;
  }

  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>
