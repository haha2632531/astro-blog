---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import PostCard from "@components/PostCard.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, 8);
---

<Layout>
  <Header />
  <main id="main-content" class="home-page">
    <h1 class="sr-only">{SITE.title}</h1>

    <div class="home-single-col">
      <ul class="card-list">
        {
          recentPosts.map(({ data, slug }) => (
            <PostCard href={`/posts/${slug}/`} frontmatter={data} />
          ))
        }
      </ul>

      <div class="all-posts-btn-wrapper">
        <LinkButton href="/posts/">
          去文章归档
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
            ><path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path></svg
          >
        </LinkButton>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* 配色变量保持原值，这里只承载单栏阅读流的容器与归档入口 */
  .home-page {
    --home-ink: #252820;
    --home-muted: #77786f;
    --home-accent: #d65b3e;
  }

  :global(html[data-theme="dark"]) .home-page {
    --home-ink: #f0eee5;
    --home-muted: #aaa99e;
    --home-accent: #f28a69;
  }

  .home-single-col {
    max-width: 62rem;
    margin-inline: auto;
    padding: 2.5rem 1rem 0;
  }

  .all-posts-btn-wrapper {
    margin: 2rem 0 4rem;
    text-align: left;
  }

  .all-posts-btn-wrapper a {
    border: 1px solid rgb(var(--color-border));
    border-radius: 0;
    background: transparent;
    color: var(--home-ink);
  }

  .all-posts-btn-wrapper a:hover {
    border-color: var(--home-accent);
    color: var(--home-accent);
  }

  .all-posts-btn-wrapper svg {
    fill: currentColor;
  }
</style>
